        <mxCell id="nJWx6yvzsWYhRuNXCPuC-687" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font face=&quot;Roboto Mono&quot; data-font-src=&quot;https://fonts.googleapis.com/css?family=Roboto+Mono&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;class&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(111, 66, 193);&quot;&gt;PathFinder&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(111, 66, 193);&quot;&gt;object&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;):&lt;br/&gt;  &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(111, 66, 193);&quot;&gt;__init__&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;self, graph, s&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;):&lt;br/&gt;    self._dist_to = &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(227, 98, 9);&quot;&gt;dict&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;()&lt;br/&gt;    self._edge_to = &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(227, 98, 9);&quot;&gt;dict&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;()&lt;br/&gt;&lt;br/&gt;    queue = Queue()&lt;br/&gt;    queue.enqueue(s)&lt;br/&gt;    self._dist_to[s] = &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(0, 92, 197);&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;&lt;br/&gt;    self._edge_to[s] = &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(0, 92, 197);&quot;&gt;None&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;&lt;br/&gt;    &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;while&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;not&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; queue.is_empty():&lt;br/&gt;      v = queue.dequeue()&lt;br/&gt;      &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;for&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; w &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;in&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; graph.adjacent_to(v):&lt;br/&gt;        &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; w &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;not&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;in&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; self._dist_to:&lt;br/&gt;          queue.enqueue(w)&lt;br/&gt;          self._dist_to[w] = &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(0, 92, 197);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; + self._dist_to[v] &lt;br/&gt;          self._edge_to[w] = v&lt;br/&gt;&lt;br/&gt;  &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(111, 66, 193);&quot;&gt;distance_to&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;self, v&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;):&lt;br/&gt;    &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; self._dist_to[v]&lt;br/&gt;&lt;br/&gt;  &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(111, 66, 193);&quot;&gt;has_path_to&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;self, v&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;):&lt;br/&gt;    &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; v &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;in&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; self._dist_to&lt;br/&gt;&lt;br/&gt;  &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(111, 66, 193);&quot;&gt;path_to&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;self, v&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;):&lt;br/&gt;    path = []&lt;br/&gt;    &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;while&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; v &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;is&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;not&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(0, 92, 197);&quot;&gt;None&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;:&lt;br/&gt;      path += [v]&lt;br/&gt;      v = self._edge_to[v]&lt;br/&gt;    &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(215, 58, 73);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-size: 18px; white-space: pre; color: rgb(227, 98, 9);&quot;&gt;reversed&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 41, 46); font-size: 18px; white-space: pre;&quot;&gt;(path)&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="650" width="560" x="5000" y="5440" as="geometry" />
        </mxCell>
